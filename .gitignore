# macOS
.DS_Store

# Xcode / SwiftPM
xcuserdata/
*.xcuserstate
DerivedData/
.build/
.swiftpm/

# CMake (future FreeRDP vendored build)
build/
build-asan/
build-tsan/
cmake-build-*/

# XcodeGen-generated project — regenerate with `xcodegen generate --spec App/project.yml`
# (adr/0006 §2: committing vs. generating is a one-week trial, revisit after)
App/*.xcodeproj

# Optional per-machine XcodeGen override (maintainer signing identity — see the
# include at the top of App/project.yml)
App/project-local.yml

# oh-my-claudecode operational state — not project source (see ~/.claude/CLAUDE.md)
.omc/

# SBOM is generated by Scripts/gen-notices.sh and committed at release time, not on
# every commit (adr/0006 §5) — untrack it between releases so it doesn't churn on every
# local build.
sbom/

# Secrets & local-only files — never tracked, from day 1
.env*
CLAUDE.local.md
# AGENTS.md untracked per owner instruction (2026-08-31): agent-facing working rules
# stay maintainer-local; the public-facing summary lives in README.md's conventions
# section. History before the removal still holds the last tracked revision.
AGENTS.md
samples-local/
.claude/settings.local.json
.claude/RESUME.md
.remember/

# AI-collab entry point for this repo is the tracked AGENTS.md; CLAUDE.md is a
# private local overlay, and engineering docs are maintained privately (owner
# decision, 2026-08-22) — both untracked since going public.
CLAUDE.md
docs/
