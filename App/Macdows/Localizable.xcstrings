      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the Windows PC you want to use. You need its host name or address, and a Windows account that can sign in with Remote Desktop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用する Windows PC を追加します。ホスト名またはアドレスと、リモートデスクトップでサインインできる Windows アカウントが必要です。"
