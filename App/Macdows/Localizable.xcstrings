    "a_reset_b" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows forgets every pinned fingerprint. On its next connection, a host with an expected certificate fingerprint is checked against it again; any other host asks you to confirm its certificate again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows はピン留め済みのフィンガープリントをすべて消去します。次回の接続時、想定される証明書のフィンガープリントを入力したホストはそれと照合し直し、それ以外のホストでは証明書をもう一度確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows 将清除全部已固定的指纹。下次连接时，填写了预期的证书指纹的主机会再次与之比对；其他主机会请你重新确认证书。"
          }
        }
      }
    },
    "a_reset_done" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
