    "d_gr_b" : {
      "comment" : "Banner body after the host refused a reconnect; %@ is the host (UI slice 4)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ refused the reconnect, so Macdows stopped without trying again. The Windows session should still be running on the host; Reconnect tries once more."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が再接続を拒否したため、Macdows は再試行せずに停止しました。Windows のセッションはホスト上でまだ実行中のはずです。「再接続」でもう一度試します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了重连，因此 Macdows 未再重试就停止了。Windows 会话应仍在主机上运行；“重新连接”会再试一次。"
          }
        }
      }
    },
    "d_gr_t" : {
      "comment" : "Banner title after the host refused a reconnect (UI slice 4)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host refused the connection"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストが接続を拒否しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机拒绝了连接"
          }
        }
      }
    },
    "d_gx_b" : {
      "comment" : "Banner body after the reconnects ran out; %1$@ is the host, %2$lld the number of reconnects (UI slice 4)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ didn’t answer %2$lld reconnect attempts. The Windows session should still be running on the host; Reconnect starts a new connection to it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は %2$lld 回の再接続に応答しませんでした。Windows のセッションはホスト上でまだ実行中のはずです。「再接続」で新しく接続します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 没有响应 %2$lld 次重连。Windows 会话应仍在主机上运行；“重新连接”会新建一个到它的连接。"
          }
        }
      }
    },
    "d_gx_t" : {
