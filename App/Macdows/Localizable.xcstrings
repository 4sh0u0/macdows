    "cc_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host may have a new certificate, or someone may be intercepting the connection. Replace the pin only if you checked the new fingerprint on the host itself."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストの証明書が新しくなった可能性も、誰かが接続を傍受している可能性もあります。ホスト本体で新しいフィンガープリントを確認した場合にのみ、ピン留めを置き換えてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机可能换了新证书，也可能有人在拦截连接。只有在主机本机上核对过新指纹后，才替换固定。"
          }
        }
      }
    },
    "cc_check" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I compared the new fingerprint on the host and it matches"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト側で新しいフィンガープリントを照合し、一致しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已在主机上核对新指纹，两者一致"
          }
        }
      }
    },
    "cc_lost" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pinned fingerprint is missing from your Keychain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留め済みのフィンガープリントがキーチェーンから失われています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的钥匙串中缺少已固定的指纹。"
          }
        }
      }
    },
    "cc_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The certificate of %@ has changed"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の証明書が変更されました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的证书已变更"
          }
        }
      }
    },
    "cc_warn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fingerprint changed since last pin. Macdows did not connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のピン留め以降にフィンガープリントが変わりました。Macdows は接続していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指纹自上次固定后已变更。Macdows 没有连接。"
          }
        }
      }
    },
    "cd_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows connects to this host only while it presents this fingerprint. Pinned on %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストがこのフィンガープリントを提示する間だけ、Macdows は接続します。ピン留め日：%@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当该主机出示此指纹时，Macdows 才会连接。固定于 %@。"
          }
        }
      }
    },
    "cd_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pin changes only when you replace it after a certificate change, or reset all pins in Settings. A changed certificate is never accepted silently."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留めが変わるのは、証明書の変更後にユーザが置き換えたときか、設定ですべてのピン留めをリセットしたときだけです。変更された証明書が黙って受け入れられることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在证书变更后由你替换，或在设置中重置全部固定时，固定才会改变。变更的证书绝不会被静默接受。"
          }
        }
      }
    },
    "cd_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
