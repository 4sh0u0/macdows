    "cc_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host may have a new certificate, or someone may be intercepting the connection. Replace the pin only if you checked the new fingerprint on the host itself."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストの証明書が新しくなった可能性も、誰かが接続を傍受している可能性もあります。ホスト本体で新しいフィンガープリントを確認した場合にのみ、ピン留めを置き換えてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机可能换了新证书，也可能有人在拦截连接。只有在主机本机上核对过新指纹后，才替换固定。"
          }
        }
      }
    },
    "cc_check" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I compared the new fingerprint on the host and it matches"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト側で新しいフィンガープリントを照合し、一致しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已在主机上核对新指纹，两者一致"
          }
        }
      }
    },
