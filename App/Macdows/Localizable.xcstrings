    "he_fp_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommended. The first connection is checked against it and a mismatch is handled like a changed certificate. If you leave it empty, you compare the fingerprint yourself on first connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力をおすすめします。最初の接続時に照合され、一致しない場合は証明書の変更として扱われます。空欄のままなら、最初の接続時にご自身でフィンガープリントを照合します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议填写。首次连接会与之比对，不一致按证书变更处理。留空则在首次连接时由你自行比对指纹。"
          }
        }
      }
    },
