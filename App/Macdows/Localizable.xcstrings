          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的证书已变更"
          }
        }
      }
    },
    "cc_warn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fingerprint changed since last pin. Macdows did not connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のピン留め以降にフィンガープリントが変わりました。Macdows は接続していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指纹自上次固定后已变更。Macdows 没有连接。"
          }
        }
      }
    },
    "cd_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows connects to this host only while it presents this fingerprint. Pinned on %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストがこのフィンガープリントを提示する間だけ、Macdows は接続します。ピン留め日：%@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当该主机出示此指纹时，Macdows 才会连接。固定于 %@。"
          }
        }
      }
    },
    "cd_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pin changes only when you replace it after a certificate change, or reset all pins in Settings. A changed certificate is never accepted silently."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留めが変わるのは、証明書の変更後にユーザが置き換えたときか、設定ですべてのピン留めをリセットしたときだけです。変更された証明書が黙って受け入れられることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
