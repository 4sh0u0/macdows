    },
    "cf_u_b" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows couldn’t open a connection to %1$@ on port %2$d. Check that the PC is turned on, is on a network this Mac can reach, and allows Remote Desktop connections."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows はポート %2$d で %1$@ への接続を開けませんでした。PC の電源が入っていること、この Mac から到達できるネットワーク上にあること、リモートデスクトップ接続を許可していることを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows 无法在端口 %2$d 上打开到 %1$@ 的连接。请检查这台电脑已开机、位于这台 Mac 能访问的网络中，并且允许远程桌面连接。"
          }
        }
      }
    },
