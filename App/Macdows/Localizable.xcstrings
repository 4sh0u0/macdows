    "cf_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the first connection to this host. Compare the fingerprint below with the one the host shows for its Remote Desktop certificate before you trust it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストへの最初の接続です。信頼する前に、下のフィンガープリントを、ホスト側で表示されるリモートデスクトップ証明書のものと照合してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是首次连接此主机。信任之前，请将下方指纹与主机上显示的远程桌面证书指纹进行比对。"
          }
        }
      }
    },
    "cf_c_b" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host presented a certificate that doesn’t match the pinned fingerprint, so Macdows did not connect. Review the new fingerprint before you decide anything."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストが提示した証明書がピン留め済みのフィンガープリントと一致しないため、Macdows は接続しませんでした。判断する前に新しいフィンガープリントを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
