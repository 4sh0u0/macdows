    "wn_gr" : {
      "comment" : "Remote windows card after the host refused a reconnect (UI slice 4)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No remote windows. The host refused the connection, so Macdows did not retry. Connect tries again once."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートウインドウはありません。ホストが接続を拒否したため、Macdows は再試行していません。「接続」でもう一度試します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有远程窗口。主机拒绝了连接，因此 Macdows 没有重试。“连接”会再试一次。"
          }
        }
      }
    },
    "wn_gx" : {
      "comment" : "Remote windows card after the reconnects ran out (UI slice 4)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No remote windows. The Windows session should still be running on the host; Connect starts a new connection to it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートウインドウはありません。Windows のセッションはホスト上でまだ実行中のはずです。「接続」で新しく接続します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有远程窗口。Windows 会话应仍在主机上运行；“连接”会新建一个到它的连接。"
          }
        }
      }
    },
    "wn_retry" : {
      "comment" : "Remote windows card while reconnecting (UI slice 4)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote windows close while the connection is down and reappear when the host sends them again after reconnecting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が切れている間はリモートウインドウが閉じ、再接続後にホストが再送すると再び表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接中断期间远程窗口会关闭；重新连接后，主机再次发送时它们会重新出现。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
