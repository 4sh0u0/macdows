    "a_export_n" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves recent logs to a file you choose. It names your hosts. Account names and key-witness lines are left out unless you include them below. Review the file before you share it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近のログを選択したファイルに保存します。ファイルにはホスト名が含まれます。下で含めるように選ばない限り、アカウント名と key-witness 行は除外されます。共有する前にファイルの内容を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将最近的日志存储到你选择的文件中。文件中会出现你的主机名。除非你在下方选择包含，否则账户名和 key-witness 行会被排除。分享前请先检查该文件。"
          }
        }
      }
    },
