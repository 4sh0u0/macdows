    },
    "cf_n_b" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host didn’t accept the user name or password (Network Level Authentication). Your saved password was not changed. Enter the password again to try once more."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストがユーザ名またはパスワードを受け付けませんでした（ネットワークレベル認証）。保存済みのパスワードは変更されていません。パスワードを入力し直すと、もう一度試せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机未接受用户名或密码（网络级别身份验证）。你存储的密码没有更改。重新输入密码即可再试一次。"
          }
        }
      }
    },
    "cf_n_t" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign-in to %@ failed"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ へのサインインに失敗しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录 %@ 失败"
          }
        }
      }
    },
    "cf_route_b" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection was redirected or went through a gateway, which Macdows does not support, so it did not connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続がリダイレクトされたか、ゲートウェイを経由しました。Macdows はこれに対応していないため、接続しませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接被重定向或经过了网关，Macdows 不支持这种情况，因此没有连接。"
          }
        }
      }
    },
    "cf_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify the identity of %@"
          }
        },
        "ja" : {
          "stringUnit" : {
