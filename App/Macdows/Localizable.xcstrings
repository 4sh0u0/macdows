          "stringUnit" : {
            "state" : "translated",
            "value" : "已固定 · SHA-256"
          }
        }
      }
    },
    "pu_b" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows could not read this host’s pinned certificate fingerprint from your Keychain, so it did not connect. Allow Macdows to use the Keychain item, then connect again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows はこのホストのピン留め済み証明書フィンガープリントをキーチェーンから読み取れなかったため、接続しませんでした。Macdows にこのキーチェーン項目の使用を許可してから、もう一度接続してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macdows 无法从你的钥匙串读取此主机已固定的证书指纹，因此没有连接。请允许 Macdows 使用该钥匙串项，然后再次连接。"
          }
        }
      }
    },
    "pu_t" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can’t read the pinned fingerprint of %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のピン留め済みフィンガープリントを読み取れません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@ 的已固定指纹"
          }
        }
      }
    },
