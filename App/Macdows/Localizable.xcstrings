    "g_drop_n" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waits 1, 2, 4 and 8 seconds before the attempts. Stops at once if the host refuses the connection. Disconnect stops it at any time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各再接続の前に 1、2、4、8 秒待ちます。ホストが接続を拒否した場合はすぐに停止します。「接続解除」でいつでも止められます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各次重连前分别等待 1、2、4、8 秒。主机拒绝连接时立即停止。随时可以用“断开连接”停止。"
          }
        }
      }
    },
