# Device Portal realtime ETW capture that runs ALONGSIDE a window-smoke run -- the server's own
# account of what it did while the Mac client was connected. Consumed by wdp-etw.command, not by
# relay.command: it opens no RDP session of its own and carries no PROGRAM.
#
# OPERATOR ORDER. Start the capture about 10 s BEFORE the run it is meant to observe, so the
# session-establishment events (ProtProvSessionCreated/Established, the gfx capability exchange)
# are inside the window rather than just before it:
#   Scripts/lab/run-scenario.sh etw smoke      # then wait for WS-OPEN in .build/lab-runtime/etw.log
#   Scripts/lab/run-scenario.sh smoke 2x-D     # the run being observed
# (or, for both of the above plus the snapshot and the gather in one step,
# `Scripts/lab/run-scenario.sh checkpoint 2x-D`, which is what jobs/checkpoint-2x-D.env is for.)
# DURATION must therefore be at least (length of the observed run) + 30 s. 150 s covers the
# ~2 min window-smoke lanes with margin; the capture ends by itself, and a capture that ends
# early loses the tail of the run, which is where the interesting frames are.
TAG=smoke
DURATION=150

# The five providers that carry the server side of the graphics pipeline. Public Microsoft
# identifiers, level 5 (verbose) each:
#   1139c61b… RemoteDesktopServices-RdpCoreTS  -- monitor layout (ID 168), gfx caps (162), session
#                                                 (66), transport (135); also carries the
#                                                 Microsoft.Windows.RemoteDesktop.ServerStack
#                                                 TraceLogging events (ServerGfxProvider: the
#                                                 RemoteAppDownsampling thresholds, surface maps)
#   c76baa63… TerminalServices-RemoteConnectionManager -- connection lifecycle
#   54de4fb6… RdpLite, f1394de0… SessionServices, ec7b8a8b… RdpAvenc -- transport and encoder
# QUOTED because the value carries `;`, which is a command separator to the shell that sources
# this file. The wrapper refuses anything that is not <guid>:<level 0-5> before it connects.
PROVIDERS='1139c61b-b549-4251-8ed3-27250a1edec8:5;c76baa63-ae81-421c-b425-340b4b24157f:5;54de4fb6-64d0-5710-3c14-13e4456119ce:5;f1394de0-32c7-4a76-a6de-b245e48f4615:5;ec7b8a8b-1432-58b3-6025-be73d4ea28ed:5'

# The portal's certificate is self-signed, so its SHA-256 is pinned in
# .build/lab-runtime/wdp/portal-cert-sha256.txt and that pin is the whole trust decision. Record
# it ONCE per machine by running this job with PIN_RECORD=1 (compare the logged fingerprint
# against what the host shows before you trust it); every run after that uses 0, and an existing
# pin is never overwritten whatever this key says.
PIN_RECORD=0

# THE CAPTURE IS NOT COMMITTABLE. .build/lab-runtime/wdp/etw-smoke.jsonl carries ServerName,
# ConnectionName, ClientIP, channel and section names -- the exact fingerprints the repo's red
# lines forbid. Quote a run through the redacting summariser instead, which prints field names,
# numbers and times and never a free-text value:
#   python3 Scripts/lab/etw_summarize.py .build/lab-runtime/wdp/etw-smoke.jsonl
# That form is safe by CONSTRUCTION: it prints field names, numeric values, counts and times, and
# no free-text field value can reach it. `--messages` is the one exception, and there the safety
# is by PATTERN rather than structural -- the summariser masks addresses, UNC paths and
# C:\Users\<name>, but a machine name that a provider wrote into the middle of a fixed English
# template (or a Message that is itself JSON) is message text, not a field, so nothing recognises
# it. Name it yourself when you need the message bodies:
#   ETW_MASK_TOKENS='<the host computer name>' python3 Scripts/lab/etw_summarize.py --messages \
#       .build/lab-runtime/wdp/etw-smoke.jsonl
