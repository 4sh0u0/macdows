# Edge-border diagnostic run, NO scale advertisement (fixture form `none`), on the same 2x display --
# the control for smoke-2x-D-edge.env: at 1x remote rendering the About window looked right (survey
# §4 pixel measurement of run 4), so its `[edge]` lines are the baseline the D run is read against.
# ADVERTISED_SCALE=none maps to WINDOW_SMOKE_ADVERTISED_SCALE=none (fixture-only knob, never the App).
TAG=2xnone-edge
BATCH=w3-edge-profile
DISPLAY_LOOKS_LIKE=1280x720
ADVERTISED_SCALE=none
MOVE=1
MAXIMIZE=0
TRAY=0
TRAY_CLICK=0
EDGE_PROFILE=1
EXTRA_APPS=notepad
MOVE_TARGET='Notepad|记事本'
REQUIRE_SYMBOL=WINDOW_SMOKE_EDGE_PROFILE
