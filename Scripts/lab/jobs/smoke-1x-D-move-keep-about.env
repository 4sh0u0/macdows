# MOVE-AND-KEEP variant of smoke-1x-D.env, About-dialog target -- the 1x CONTROL of
# smoke-2x-D-move-keep-about.env (see that file, and smoke-1x-D.env, for the full field-by-field
# rationale; repeated below only where it differs). Same advertisement, same legs, same windows,
# same keep knob -- only the display differs, which is the whole design of the 1x/2x pairs in this
# directory.
#
# WHAT IT IS FOR. The route-B wiring lane (ADR-0018 §5.2 增补二 item 2) deducts 7 remote px of left
# border from a non-WS_THICKFRAME window at 96 DPI and 11 at 192 DPI. The 2x sibling is where the
# 11 is read; this run is where the 7 is re-read on the same code, the same day, through the same
# host-side rectangle probe. Without it a 2x-only reading cannot tell "the 192 column is right"
# from "the whole wiring moved".
#
# HOW THE ABOUT DIALOG BECOMES THE MOVE TARGET: by leaving MOVE_TARGET EMPTY -- the harness's
# historical About heuristic (`MoveResizeTarget.matches(title:filter: nil)`), which locks the
# newest About-shaped window, i.e. the one this run's own base app (winver, WINDOW_SMOKE_APP's
# default) just opened. An explicit filter structurally cannot reach it: `MoveResizeTarget.lock`
# only ever locks a window that appeared AFTER the extra apps launched, and the base app's own
# window was already there. Not a title match on the About dialog, which is exactly what the
# record convention forbids.
#
# Differences from smoke-1x-D.env, and nothing else: TAG, BATCH, MOVE_KEEP=1, an EMPTY MOVE_TARGET,
# and REQUIRE_SYMBOL.
TAG=1xD-mkeep-about

# The evidence directory. It names the LANE, not the date: a dated run name is given on the command
# line instead (`run-scenario.sh smoke 1x-D-move-keep-about <date>`), which run-scenario.sh appends
# to the RUNTIME copy of this file. A tracked definition should not have to be edited to run twice.
BATCH=w3-routeb-wiring

# PREFLIGHT 1 (the display): DELIBERATELY EMPTY, and empty means the check is not merely satisfied
# but never asked (smoke-job.command's `[ -n "$DISPLAY_LOOKS_LIKE" ] &&` guard; the offline suite
# pins that system_profiler is not called at all). The 2x sibling can name its geometry because an
# exact-2x panel IS a specific looks-like string; "the ordinary 1x display" is not one, and writing
# the maintainer's own panel geometry here would put a fact about one desk into a tracked file and
# refuse the run on any other. The consequence to know about: this job does NOT prove it ran at 1x.
# The evidence does -- `[client-rect]` and `[style-dump]` carry the session geometry, and the run
# record states the display.
DISPLAY_LOOKS_LIKE=

# What this run advertises in TS_UD_CS_CORE (ADR-0018 §2 lane E). D = the PRODUCT DEFAULT, which the
# wrapper expresses by leaving WINDOW_SMOKE_ADVERTISED_SCALE unset. Identical to the 2x sibling on
# purpose: the independent variable of this pair is the display, not the advertisement -- and under
# the product default a 1x display advertises 100, which is the 96 DPI column the lane's fallback
# and its 1x byte-identity claim are both about.
ADVERTISED_SCALE=D

# The scenario legs. MOVE needs the multi-window prerequisite, which EXTRA_APPS provides --
# notepad STAYS even though notepad is not the target here (`moveResizeScenarioEnabled`'s own doc
# comment: the prerequisite is EXTRA_APPS, not the filter, and the run is not judgeable without
# it). MOVE_TARGET is DELIBERATELY EMPTY: empty means "no filter", which is the About heuristic,
# which is how this run targets the About dialog (see the header). Empty, not absent, for the same
# reason DISPLAY_LOOKS_LIKE above is written out -- the key is present so the file SAYS the
# emptiness is a choice, and the offline suite's tracked-job traversal admits a MOVE=1 job with no
# filter only when the key is written out.
MOVE=1
MAXIMIZE=0
TRAY=0
TRAY_CLICK=0
EXTRA_APPS=notepad
MOVE_TARGET=

# MOVE_KEEP=1 (WINDOW_SMOKE_MOVE_KEEP): suppress the move/resize scenario's SC_CLOSE of the locked
# target -- both of its close sites -- and nothing else. Every leg still runs and still reports its
# verdict; the window is simply left open at the end so a host-side probe run afterwards, in the
# same logged-on session, can read its rectangles. Absent or 0 is the unconditional close every
# other job gets.
#
# The consequence to plan for: this run does NOT clean up after itself. The orchestration logs off
# between runs (jobs/logoff-path.env), which is what disposes of the kept window.
MOVE_KEEP=1

# PREFLIGHT 2 (the checkout). The knob this run is NAMED for must exist in the tree that is about
# to be built -- here MOVE_KEEP's own, not the advertisement's. Without this gate a checkout that
# predates the keep knob builds cleanly, runs cleanly, closes the target at the end, and produces a
# log that looks exactly like a run of smoke-1x-D.env -- because it is one, and nothing in the
# evidence says so.
REQUIRE_SYMBOL=WINDOW_SMOKE_MOVE_KEEP
