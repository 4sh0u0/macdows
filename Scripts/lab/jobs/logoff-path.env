# Full-path twin of logoff.env: '||logoff' resolves only while the TS allow-list
# publication from the matrix Enforce step exists. On the restored host it comes back
# RAIL_EXEC_E_FILE_NOT_FOUND, so this is the one to hand-launch outside the Enforce window
# (owner ruling 2026-09-15 00:04 JST, option (b)).
PROGRAM='C:\Windows\System32\logoff.exe'
# TIMEOUT 30 (2026-10-02, was 12): ten successful logoff relay logs measured 1.5-1.9 s from dial
# to logon (`Logon Info V2`) plus 7.3-10.0 s from logon to ERRINFO_LOGOFF_BY_USER, 11.6 s at most,
# so 12 s left 0.4 s and two runs on 2026-10-02 were killed 10.2 / 10.5 s after logon, before the
# logoff landed. 30 s is >= 2.5x the measured maximum and still half of run-matrix.sh's
# WAIT_LOGOFF (60 s), the wait its logoff step allows the relay.
TIMEOUT=30
