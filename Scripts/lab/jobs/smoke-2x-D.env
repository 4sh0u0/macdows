# One window-smoke run in the W3 2x checkpoint's SHAPE 2 form: an exact-2x display, the product
# default advertisement, and the notepad + MOVE leg. Consumed by smoke-job.command (via
# `run-scenario.sh smoke 2x-D`), never by relay.command: it carries no PROGRAM and opens no
# redirected drive.
#
# This is the tracked form of what .build/lab-runtime/c2p-run2.command was on 2026-09-09 -- the
# run the checkpoint record files as "跑 2 (产品默认 D)". Everything that was hand-written in that
# file is a VALUE here; the two refuse-to-run preflight gates it carried are the wrapper's, and
# turning either of them off is a matter of clearing a key rather than deleting a line of code.
#
# TAG names smoke-<TAG>.log (the wrapper's own, polled by checkpoint.sh) and
# window-smoke-<TAG>.log (the run's evidence, under .build/evidence/<BATCH>/).
TAG=2xD

# The evidence directory this run's log lands in. It names the LANE, not the date: a dated run
# name is given on the command line instead (`run-scenario.sh smoke 2x-D checkpoint-20260910`, or
# checkpoint.sh's own second argument), which run-scenario.sh appends to the RUNTIME copy of this
# file. That is deliberate -- a tracked definition should not have to be edited to run it twice.
BATCH=w3-2x-checkpoint

# PREFLIGHT 1 (the display). Exact 2x: a QHD panel set to "looks like 1280 x 720", so the session
# desktop is 1280x720 pt x rasterScale 2 = 2560x1440 remote px. The wrapper refuses unless
# `system_profiler SPDisplaysDataType` reports `UI Looks like: 1280 x 720`. This is not a nicety:
# every remote-pixel number the run produces is judged against that geometry, and on any other
# display the run is unjudgeable rather than merely different. Clear the key to skip the check.
DISPLAY_LOOKS_LIKE=1280x720

# What this run advertises in TS_UD_CS_CORE (ADR-0018 §2 lane E). D = the PRODUCT DEFAULT, which
# the wrapper expresses by leaving WINDOW_SMOKE_ADVERTISED_SCALE unset -- exactly what the
# 2026-09-09 run 2 did with `unset WINDOW_SMOKE_ADVERTISED_SCALE`, and what makes this run a
# measurement of the shipping default rather than of a fixture knob. The sibling forms are `none`
# (the explicit off switch), `DD` (the U-1 control) and an explicit `<desktop>[,<device>]` pair.
#
# D IS THE ONE VALUE OF THIS KEY THAT DOES NOT REACH THE CHILD. The other three are passed through
# verbatim as WINDOW_SMOKE_ADVERTISED_SCALE; D removes the variable instead. That inverts the
# spelling main.swift uses -- there, an unset knob is the product default and the literal string "D"
# is a fixture proposal -- and it is deliberate: a job file says what the run ADVERTISES, and the
# product default is not something a fixture turns on. The consequence to know about is that the
# fixture's own D proposal cannot be requested through this wrapper at all; a job that needs it has
# to say `DD` (the U-1 control) or an explicit pair.
ADVERTISED_SCALE=D

# The scenario legs. MOVE needs a second window to aim at, which EXTRA_APPS provides; MOVE_TARGET
# is the title filter that picks it, spelled as an alternation because the host's Notepad titles
# itself in whichever language the session is running.
MOVE=1
MAXIMIZE=0
TRAY=0
TRAY_CLICK=0
EXTRA_APPS=notepad
MOVE_TARGET='Notepad|记事本'

# PREFLIGHT 2 (the checkout). The knob this run is NAMED for must exist in the tree that is about
# to be built. Without this gate a checkout that predates lane E builds cleanly, runs cleanly, and
# produces a log that looks exactly like a run of the default -- because it is one, and nothing in
# the evidence says so.
REQUIRE_SYMBOL=WINDOW_SMOKE_ADVERTISED_SCALE
