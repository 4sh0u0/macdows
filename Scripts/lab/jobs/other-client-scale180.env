# "Other client" for the T6-prime RA3 form (docs upgrade-gate/2026-09-t6prime-live.md section 6.1):
# Homebrew xfreerdp joins the retained RAIL session as a client that DECLARES 180 % desktop and
# device scale (TS_UD_CS_CORE desktopScaleFactor/deviceScaleFactor, written unconditionally by
# gcc_write_client_core_data), shows winver, and is disconnected -- not logged off -- by the
# relay's TIMEOUT kill. rail-probe then reconnects to the same session at the default 100 %.
PROGRAM='C:\Windows\System32\winver.exe'
# Extra xfreerdp switches. relay.command accepts ONLY /scale:<100|140|180>,
# /scale-desktop:<100-500>, /scale-device:<100|140|180> and /dynamic-resolution here; anything
# else (a /v:, a /u:, a path) is refused as JOB-ENV-INVALID before any connection attempt.
XFREERDP_EXTRA='/scale:180 /dynamic-resolution'
# Long enough for the RAIL handshake and winver to appear (rail-probe's own runs see the
# ServerExecuteResult at ~4 s), short enough that the whole form fits the 60 s rail-probe window.
TIMEOUT=20
