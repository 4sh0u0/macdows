# Upstream: https://github.com/FreeRDP/FreeRDP/pull/13287
#
# rdp_apply_input_capability_set(): read the server's answer from `src`, not from the
# destination `settings`.
#
# Target: libfreerdp/core/capabilities.c in the pinned FreeRDP 3.30.0
# (commit 6b107f0aadbabc47941c5a5b893b88c01792af6d). Applied by Scripts/build-freerdp.sh.
#
# WHAT IT FIXES (two hunks, one copy-paste defect shape)
#   The remote->live merge path for the Input Capability Set
#   (rdp_read_capability_sets -> rdp_apply_from_received -> rdp_apply_input_capability_set,
#   where `settings` is the live destination and `src` is the parsed server answer) reads
#   two of its values back out of `settings` instead of `src`. The result is a
#   self-assignment: the server's answer is parsed, then discarded.
#
#   Hunk 1, :1414 (FreeRDP_UnicodeInput) -- live FreeRDP_UnicodeInput stays at whatever
#     the client set before connecting (TRUE by default, libfreerdp/core/settings.c:943)
#     regardless of whether the server advertised INPUT_FLAG_UNICODE. Consequence in this
#     project's shape: the "server does not support Unicode input" branch
#     (libfreerdp/core/input.c:217 and :455) is unreachable against a real host, so
#     Unicode keyboard events go out to servers that never advertised the capability, and
#     the client-side degradation discipline built on that signal can never fire.
#   Hunk 2, :1423 (FreeRDP_HasQoeEvent) -- identical shape one guard later: the QoE input
#     event capability is likewise pinned to the client's own pre-connect value.
#
#   Both are two lines away from correctly written neighbours in the same function
#   (`settings->HasHorizontalWheel = src->HasHorizontalWheel;` at :1410,
#   `settings->HasExtendedMouseEvent = src->HasExtendedMouseEvent;` at :1419), which is
#   what makes the copy-paste origin unambiguous. The fix is one token per hunk.
#
#   CONSEQUENCE OF THE FIX -- WIRE-VISIBLE, for both hunks. rdp_write_input_capability_set()
#   builds our Confirm Active `inputFlags` from these same two live values (:1516-1517 for
#   INPUT_FLAG_UNICODE, :1519-1520 for TS_INPUT_FLAG_QOE_TIMESTAMPS) and runs *after* this
#   apply (connection.c:1355 rdp_recv_demand_active precedes connection.c:2197
#   rdp_send_confirm_active). Both settings default TRUE (settings.c:943, :946), so before
#   this patch we advertised both unconditionally; after it we advertise each only if the
#   server advertised it first. Against a typical Windows host, which commonly does not set
#   TS_INPUT_FLAG_QOE_TIMESTAMPS, our Confirm Active will therefore stop carrying that bit.
#   That is the upstream-correct behaviour and no code in this project reads either setting
#   apart from one UnicodeInput mirror, but it does change the bytes we put on the wire.
#
# PROVENANCE
#   Found while dispositioning an acceptance item on the input pipeline; recorded in this
#   project's docs as adr/0011 sections 7.2-7.4 (every FreeRDP read/write site of
#   UnicodeInput / INPUT_FLAG_UNICODE enumerated line-by-line against this exact pinned
#   commit, with the single remote->live channel identified). That judgement is static
#   read-of-code; the corroborating live measurement is the 2026-08-31 run against a real
#   Windows host, where the capability mirror read TRUE and the server-absent degradation
#   path never fired, exactly as the static reading predicts. No wire capture was taken --
#   see adr/0011 section 7.7 for the residual risk that leaves.
#
# UPSTREAM STATUS (checked 2026-09-01)
#   Hunk 1: FIXED in upstream master by PR #13287, merged 2026-08-27 as commit
#     21cd3d630bb6708fa7b7b841a04ae8bf972f81ba. Not in any release yet: 3.31.0 was
#     published 2026-08-26, one day before that merge (GitHub compare 3.31.0...21cd3d6
#     reports ahead_by 19 / behind_by 0). The hunk below is byte-identical to the PR's --
#     same context lines, same hunk header -- so it supersedes cleanly on the next pin
#     bump instead of conflicting in some hand-rolled variant form.
#   Hunk 2: NOT fixed upstream, master included (master's copy of capabilities.c re-read
#     2026-09-01: the HasQoeEvent line still reads `settings`). No upstream issue or PR
#     exists for it either -- a GitHub search of repo:FreeRDP/FreeRDP for HasQoeEvent
#     returned 0 results on 2026-09-01. Reporting it upstream is a planned follow-up; this
#     hunk therefore goes beyond upstream master until that lands. The PR link at the top
#     of this file (README rule 1) covers hunk 1 and is the upstream record for the shared
#     defect shape; hunk 2's own record does not exist yet and filing it is owed.
#
# RETIREMENT CONDITION (per hunk -- both must be met before the file itself is deleted)
#   Hunk 1: retire on the first FreeRDP release that contains PR #13287, i.e. the first
#     release cut from master after 3.31.0. The pin bump replays this queue (README rule
#     3) and `git apply` will fail hard on this hunk at that moment (README rule 2) --
#     that failure is the intended, self-announcing retirement signal, not a regression.
#   Hunk 2: retire when the upstream report/PR for the HasQoeEvent line is merged AND
#     shipped in a release this project has pinned. Until then the hunk stays, and it is
#     the item README rule 4's quarterly review exists for.
#
diff --git a/libfreerdp/core/capabilities.c b/libfreerdp/core/capabilities.c
index ec9cfa8d0..13ee03941 100644
--- a/libfreerdp/core/capabilities.c
+++ b/libfreerdp/core/capabilities.c
@@ -1411,7 +1411,7 @@ static BOOL rdp_apply_input_capability_set(rdpSettings* settings, const rdpSetti
 		const BOOL UnicodeInput = freerdp_settings_get_bool(settings, FreeRDP_UnicodeInput);
 		if (UnicodeInput)
 		{
-			const BOOL srcVal = freerdp_settings_get_bool(settings, FreeRDP_UnicodeInput);
+			const BOOL srcVal = freerdp_settings_get_bool(src, FreeRDP_UnicodeInput);
 			if (!freerdp_settings_set_bool(settings, FreeRDP_UnicodeInput, srcVal))
 				return FALSE;
 		}
@@ -1420,7 +1420,7 @@ static BOOL rdp_apply_input_capability_set(rdpSettings* settings, const rdpSetti
 		if (settings->HasRelativeMouseEvent)
 			settings->HasRelativeMouseEvent = src->HasRelativeMouseEvent;
 		if (freerdp_settings_get_bool(settings, FreeRDP_HasQoeEvent))
-			settings->HasQoeEvent = freerdp_settings_get_bool(settings, FreeRDP_HasQoeEvent);
+			settings->HasQoeEvent = freerdp_settings_get_bool(src, FreeRDP_HasQoeEvent);
 	}
 	return TRUE;
 }
